{
  "manifest_version": 3,
  "name": "Batdongsan.com.vn Scraper",
  "version": "1.0",
  "description": "Automatically scrape real estate listings from batdongsan.com.vn",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://batdongsan.com.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://batdongsan.com.vn/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Batdongsan Scraper"
  }
}