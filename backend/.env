# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dinh_gia_bds
DB_USER=postgres
DB_PASSWORD=postgres123

# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Valuation Service
VALUATION_CACHE_TTL=3600
VALUATION_MAX_COMPARABLES=10
VALUATION_SEARCH_RADIUS_KM=5